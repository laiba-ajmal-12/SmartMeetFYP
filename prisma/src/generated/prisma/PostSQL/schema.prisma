generator postgresqlClient {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/PostSQL"
}

datasource PostSQLDB {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id           Int                  @id @default(autoincrement())
  name         String
  email        String               @unique
  password     String
  ImagePath    String?
  createdAt    DateTime             @default(now())
  organization Organization[]
  member       OrganizationMember[]
  meetings     Meeting[]
}

model Organization {
  id Int @id @default(autoincrement())

  name                  String
  description           String
  ImagePath             String?
  createAt              DateTime @default(now())
  organizationCode      String   @unique
  domainName            String?
  domainRestrictionFlag Boolean  @default(false)
  ownerId               Int
  owner                 Users    @relation(fields: [ownerId], references: [id])

  meeting Meeting[]
  members OrganizationMember[]

  @@index([ownerId])
}

model OrganizationMember {
  id Int @id @default(autoincrement())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId   Int
  user     Users    @relation(fields: [userId], references: [id])
  joinedAt DateTime @default(now())

  @@unique([organizationId, userId])
  @@index([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Meeting {
  id             Int          @id @default(autoincrement())
  name           String
  description    String?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  daily          Boolean      @default(false)
  weekly         Boolean      @default(false)
  startTime      DateTime
  endTime        DateTime?
  hostId         Int
  host           Users        @relation(fields: [hostId], references: [id])

  @@index([organizationId])
  @@index([hostId])
}
